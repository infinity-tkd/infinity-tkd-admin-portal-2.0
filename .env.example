# Copy to .env.local. Use your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
# Server only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
APP_URL=https://admin.example.com
# Enable only when the hosting proxy overwrites incoming forwarded IP headers.
# Otherwise login attempts share a conservative global rate limit.
TRUST_PROXY_HEADERS=false
# Optional AI features; keep this server only.
# GEMINI_API_KEY=
# Development options (never enable insecure TLS in production).
# ENABLE_PWA_DEV=false
# Restore Node stack source maps when debugging the development server.
# PORTAL_DEV_SOURCE_MAPS=1
